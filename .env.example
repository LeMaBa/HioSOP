# Application
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sopnavigator
POSTGRES_USER=sopuser
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://sopuser:changeme@db:5432/sopnavigator

# Redis
REDIS_URL=redis://redis:6379/0

# Resend email (optional — leave empty to disable email sending)
# Get your API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM=SOP-Navigator <noreply@yourdomain.com>
APP_BASE_URL=https://your-app-url.com

# LDAP (optional, leave empty to disable)
LDAP_SERVER=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_ATTR=sAMAccountName

# Frontend
VITE_API_BASE_URL=http://localhost:8000
